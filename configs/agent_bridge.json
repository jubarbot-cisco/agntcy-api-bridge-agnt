{
    "name": "Agent Bridge API",
    "api_id": "agent_bridge_id",
    "version_data": {
        "not_versioned": true
    },
    "proxy": {
        "listen_path": "/acp/",
        "target_url": "",
        "strip_listen_path": true
    },
    "custom_middleware":{
        "pre": [
            {
                "disabled": false,
                "name": "ProcessACPQuery",
                "path": "middleware/agent-bridge-plugin.so",
                "require_session": false,
                "raw_body_only": false
            }
        ],
        "post": [],
        "response": [
            {
                "disabled": false,
                "name": "ProcessACPResponse",
                "path": "middleware/agent-bridge-plugin.so",
                "require_session": false,
                "raw_body_only": false
            }
        ],
        "driver": "goplugin"
    }
}
